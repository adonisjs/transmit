{
  "name": "@adonisjs/transmit",
  "description": "A Server-Sent-Event module bringing real-time capabilities to AdonisJS.",
  "version": "3.0.0",
  "engines": {
    "node": ">=20.11.1"
  },
  "main": "build/index.js",
  "type": "module",
  "files": [
    "src",
    "providers",
    "index.ts",
    "configure.ts",
    "build"
  ],
  "exports": {
    ".": "./build/index.js",
    "./transports": "./build/transports.js",
    "./transmit_provider": "./build/providers/transmit_provider.js",
    "./controllers/*": "./build/src/controllers/*.js",
    "./services/main": "./build/services/transmit.js",
    "./types": "./build/src/types/main.js"
  },
  "scripts": {
    "build": "npm run compile",
    "clean": "del-cli build",
    "compile": "npm run clean && tsc",
    "copy:templates": "copyfiles \"stubs/**/**/*.stub\" build",
    "format": "prettier --write .",
    "lint": "eslint . --ext=.ts",
    "postcompile": "npm run copy:templates",
    "precompile": "npm run lint",
    "prepublishOnly": "npm run build",
    "pretest": "npm run lint",
    "quick:test": "node --enable-source-maps --loader=ts-node/esm bin/test.ts",
    "release": "npx release-it",
    "test": "c8 npm run quick:test",
    "typecheck": "tsc --noEmit",
    "version": "npm run build"
  },
  "dependencies": {
    "@boringnode/transmit": "^0.4.0"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0-next.31",
    "@adonisjs/core": "^7.0.0-next.26",
    "@adonisjs/eslint-config": "^3.0.0-next.9",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0-next.3",
    "@boringnode/bus": "^0.9.0",
    "@commitlint/config-conventional": "^20.3.1",
    "@japa/assert": "2.1.0",
    "@japa/runner": "3.1.1",
    "@swc/core": "1.4.11",
    "@types/node": "^25.0.10",
    "c8": "^10.1.3",
    "copyfiles": "^2.4.1",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "release-it": "^19.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.0.0-next"
  },
  "author": "Romain Lanz <romain.lanz@pm.me>",
  "license": "MIT",
  "keywords": [
    "sse",
    "server-sent-event",
    "adonis",
    "adonisjs",
    "adonis-framework",
    "realtime",
    "real-time"
  ],
  "homepage": "https://github.com/adonisjs/transmit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adonisjs/transmit.git"
  },
  "bugs": {
    "url": "https://github.com/adonisjs/transmit/issues"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "prettier": "@adonisjs/prettier-config",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  }
}
